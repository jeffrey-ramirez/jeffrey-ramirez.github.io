# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
# Defaults to https://jeffrey-ramirez.github.io
NEXT_PUBLIC_SITE_URL=

# Optional form backend for the contact form, e.g. https://formspree.io/f/xxxxxxxx
# Without it, "Send Message" opens the visitor's email app with the message prefilled.
NEXT_PUBLIC_CONTACT_ENDPOINT=
