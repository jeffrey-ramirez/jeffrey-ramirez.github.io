# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://jeffreyramirez.dev

# Contact form delivery via Resend (https://resend.com).
# Without these, development logs messages to the console and production returns 503
# (the form then points visitors to your email address).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend
CONTACT_FROM_EMAIL="Portfolio <hello@jeffreyramirez.dev>"
